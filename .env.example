# Copy to .env and fill in. .env is gitignored — never commit real values.
# Secrets themselves live in Google Secret Manager; only their NAMES appear here.

# --- Google Cloud -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=gen-lang-client-0473437618
GOOGLE_CLOUD_PROJECT_NUMBER=184359031908
GOOGLE_CLOUD_LOCATION=europe-west3

# ============================================================================
#  MODEL CREDENTIALS — the only secret in this file. Pick ONE path.
# ============================================================================
#
#  PATH A — Gemini API (recommended while building)
#      Free tier, so iteration costs nothing and your $10 of Google credit
#      survives for the demo runs. Get a key: https://aistudio.google.com/apikey
#
#        GOOGLE_GENAI_USE_ENTERPRISE=0
#        GOOGLE_API_KEY=AIza...            <-- paste yours below
#
#  PATH B — Vertex AI (what the deployed submission uses)
#      No key at all. Authenticates as you locally, or as the Cloud Run service
#      account once deployed:
#
#        GOOGLE_GENAI_USE_ENTERPRISE=1
#        gcloud auth application-default login
#
#  Both satisfy the hackathon rules ("Gemini API or Vertex AI"), so flip the
#  one flag between them. Neither is needed for `make demo`, `make test` or
#  `make probe` — those run against scripted models.
#
#  This file is gitignored. Never commit a key; if one leaks, revoke it in
#  AI Studio immediately rather than rotating around it.
# ----------------------------------------------------------------------------

GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=

# --- Azure estate -----------------------------------------------------------
AZURE_SUBSCRIPTION_ID=77f69e31-9603-4766-8e47-93a380c2cfd1
AZURE_REGION=germanywestcentral

# aks | gke | fake   — `fake` needs no cloud at all and is the default for tests.
# Switching aks -> gke when the Google credits land is this one line (ADR-005).
ESTATE_ADAPTER=fake
ESTATE_NAMESPACE=demo

# --- GitOps -----------------------------------------------------------------
GITHUB_OWNER=mazzyy
GITOPS_REPO=estate-gitops
GITOPS_BASE_BRANCH=main

# --- Secret Manager secret NAMES (not values) -------------------------------
SECRET_GITHUB_TOKEN=github-token
SECRET_AKS_TOKEN=aks-reader-token
SECRET_AKS_APISERVER=aks-apiserver

# --- Budget guards ----------------------------------------------------------
# Enforced by the proxy before every dispatch. This is what stops a runaway
# loop from eating the credit balance.
BUDGET_USD_CAP=5.0
BUDGET_WARN_RATIO=0.8

# --- Runtime ----------------------------------------------------------------
PUBSUB_TOPIC=warden-events
MANIFEST_DIR=manifests/agents
WARDEN_USE_FIXTURES=false
LOG_LEVEL=INFO
