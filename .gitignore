.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Never commit these. Secrets live in Secret Manager; .env is local only.
# .env.* catches backups too — a .env.bak made while editing still holds the
# token, and `git add .` does not care that you meant it as a scratch file.
.env
# `.env*` not `.env.*` — the dotted glob misses `.env copy`, which is exactly
# what macOS Finder and "duplicate file" produce, and which GitHub's push
# protection caught holding a live PAT. Any file whose name starts with .env
# is a credential file until proven otherwise.
.env*
!.env.example
*.pem
*.key
kubeconfig*
service-account*.json

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# Dashboard build output
warden/dashboard/web/node_modules/
warden/dashboard/web/dist/

# Local incident store written by `make demo-live` and the dashboard.
# Runtime state, not source: it changes on every run and belongs to a machine,
# not to the repository.
.warden-state/
